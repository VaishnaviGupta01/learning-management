# Copy to .env and adjust. docker-compose reads .env automatically.

# ---------------------------------------------------------------- Ports
BACKEND_PORT=8080
ML_SERVICE_PORT=8001
RAG_SERVICE_PORT=8002
FRONTEND_PORT=5173

# ---------------------------------------------------------------- Database (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms
DB_USER=lms
DB_PASSWORD=lms
# none | validate | update | create | create-drop
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---------------------------------------------------------------- Security / auth (Phase 3)
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
# Initial admin account created on first startup
ADMIN_EMAIL=admin@lms.local
ADMIN_PASSWORD=ChangeMe123!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Seed the demo dataset (3 courses, 108 questions, 15 simulated students; password Demo12345!). Runs once.
SEED_DEMO_DATA=false

# ---------------------------------------------------------------- Service URLs (host-side defaults; compose overrides for containers)
BACKEND_URL=http://localhost:8080
ML_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002
# Shared secret for service-to-service calls
INTERNAL_API_KEY=change-me-internal-key

# ---------------------------------------------------------------- File uploads (documents for RAG)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=25MB

# ---------------------------------------------------------------- ML service (knowledge tracing / recommendations)
ML_MODEL_DIR=./models
ML_SERVICE_TIMEOUT_MS=3000
# Optional JSON overrides of the defaults in ml-service/app/config.py, e.g.
# KNOWLEDGE_WEIGHTS={"diagnostic":0.4,"recent_quiz":0.3,"practice":0.2,"revision":0.1}
# KNOWLEDGE_THRESHOLDS={"STRONG":0.8,"MODERATE":0.6,"NEEDS_PRACTICE":0.4}
# RECOMMEND_WEIGHTS={"knowledge_gap":0.5,"importance":0.3,"urgency":0.2}
RECOMMENDATION_TOP_K=5
# Prerequisites count as complete at this mastery score (backend gating)
PREREQUISITE_MASTERY_THRESHOLD=0.6
# Spaced repetition intervals in days, matching RevisionStage
REVISION_INTERVALS_DAYS=1,3,7,14,30

# ---------------------------------------------------------------- Adaptive quizzes (Phase 9)
ADAPTIVE_WINDOW=10
ADAPTIVE_QUESTION_COUNT=10

# ---------------------------------------------------------------- RAG service / LLM (Phase 10)
# Read only by rag-service; never sent to the browser or returned by any API. LLM_API_KEY works as an alias.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# Re-run requests declined by safety classifiers on Anthropic's recommended fallback model
LLM_REFUSAL_FALLBACK=true
LLM_TIMEOUT_SECONDS=90
RAG_SERVICE_TIMEOUT_MS=120000

# ---------------------------------------------------------------- RAG (Phase 11)
# Downloaded from huggingface.co on first upload, then cached in the rag-data volume.
# bge-small reads 512 tokens per chunk (all-MiniLM-L6-v2 would stop at 256).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=5
# Cosine similarity below which retrieved text is not treated as evidence ("not in course material")
RAG_MIN_SIMILARITY=0.55

# ---------------------------------------------------------------- Frontend (baked in at build time)
VITE_BACKEND_URL=http://localhost:8080
VITE_ML_SERVICE_URL=http://localhost:8001
VITE_RAG_SERVICE_URL=http://localhost:8002
